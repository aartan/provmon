# Local development — committed as a template, copy to .env.local (never commit real secrets)
# Infrastructure (docker-compose.yml defaults; POSTGRES_PORT overrides the host port if 5432 is taken)
DATABASE_URL="postgresql://provmon:provmon@localhost:5432/provmon"
REDIS_URL="redis://localhost:6379"
POSTGRES_PORT=5432

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Email (Resend) — set in Phase 4
RESEND_API_KEY=""
EMAIL_FROM="ProvMon <provmon@example.com>"

# Dev-only: SMTP endpoint for local email testing (mailpit)
DEV_SMTP_HOST="localhost"
DEV_SMTP_PORT="1025"

# Local development — committed as a template, copy to .env.local (never commit real secrets)
# Web app port (used for the production container's host mapping).
APP_PORT=3100
# Infrastructure (docker-compose.yml defaults; POSTGRES_PORT overrides the host port if 5432 is taken)
DATABASE_URL="postgresql://provmon:provmon@localhost:5432/provmon"
# Redis requires authentication. Generate a password with: openssl rand -hex 32
# REDIS_PASSWORD must match the password embedded in REDIS_URL.
REDIS_PASSWORD=""
REDIS_URL="redis://:CHANGE_ME@localhost:6379"
POSTGRES_PORT=5432

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Email (Resend) — set in Phase 4
RESEND_API_KEY=""
EMAIL_FROM="ProvMon <provmon@example.com>"

# Dev-only: SMTP endpoint for local email testing (mailpit)
DEV_SMTP_HOST="localhost"
DEV_SMTP_PORT="1025"

# Retailer plugins. Install plugin packages under this directory and list
# them in plugins/provmon.plugins.json (or set PROVMON_PLUGINS to a
# comma-separated package list). Plugin-specific environment variables are
# declared by each plugin's provmon.plugin.json.
PROVMON_PLUGIN_DIR="plugins"
PROVMON_PLUGINS=""

# Catalogue discovery: pause between retailer API pages (milliseconds) and
# optional comma-separated emails allowed to manage retailer discovery.
CATALOGUE_PAGE_DELAY_MS=500
CATALOGUE_ADMIN_EMAILS=""

# Optional: default cadence for unchanged history snapshots, in minutes.
# 0 disables unchanged snapshots; per-subscription settings override this.
SNAPSHOT_INTERVAL_MINUTES=1440

# Optional: cadence for checks driven only by inventory historical alerts
# (listings without a monitoring subscription). Defaults to daily.
ALERT_CHECK_INTERVAL_MINUTES=1440

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://provmon.dev/schemas/provmon.plugin.schema.json",
  "title": "ProvMon retailer plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "name",
    "entry",
    "supportedDomains",
    "currency",
    "minCheckIntervalMs",
    "treatNotFoundAsOutOfStock",
    "capabilities"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "type": "integer", "minimum": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "entry": { "type": "string", "minLength": 1, "maxLength": 512 },
    "supportedDomains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 253 }
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "minCheckIntervalMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800000
    },
    "treatNotFoundAsOutOfStock": { "type": "boolean" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCataloguePageItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        }
      }
    },
    "configuration": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "env"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
          },
          "env": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "default": {
            "type": ["string", "number", "boolean"]
          },
          "required": { "type": "boolean" },
          "secret": { "type": "boolean" }
        }
      }
    }
  }
}

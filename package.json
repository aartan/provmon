{
  "name": "provmon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:sdk && next dev -p ${PORT:-3100}",
    "build": "npm run build:sdk && next build",
    "build:sdk": "npm run build -w @provmon/retailer-plugin-sdk",
    "dev:sdk": "npm run dev -w @provmon/retailer-plugin-sdk",
    "start": "next start -p ${PORT:-3100}",
    "lint": "eslint",
    "typecheck": "npm run build:sdk && tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "plugins:list": "tsx scripts/plugins.ts list",
    "plugins:validate": "tsx scripts/plugins.ts validate",
    "plugins:link-local": "tsx scripts/plugins.ts link-local",
    "test": "npm run build:sdk && vitest run",
    "test:watch": "npm run build:sdk && vitest"
  },
  "dependencies": {
    "@provmon/retailer-plugin-sdk": "*",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.7.6",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.11",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.10.1",
    "resend": "^6.38.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "type": "module"
}
